{
  "name": "LTC Time Converter",
  "type": "Time",
  "path": "Custom",

  "version": "1.0.0",
  "description": "Convert between float seconds and HH:MM:SS:FF timecode format",
  "url":"https://github.com/NANAIRO-Creative/LTC-Time-Converter-module",
  "downloadURL":"https://github.com/NANAIRO-Creative/LTC-Time-Converter-module/archive/master.zip",

  "hasInput": false,
  "hasOutput": false,

  "hideDefaultCommands": true,

  "parameters": {
    "frameRate": {
      "type": "Float",
      "default": 30.0,
      "min": 1.0,
      "max": 120.0,
      "description": "Frame rate for timecode conversion"
    },
    "inputTimecode": {
      "type": "String",
      "default": "00:00:00:00",
      "description": "Input timecode HH:MM:SS:FF (manual entry)"
    }
  },

  "scripts": [
    "moduleScript.js"
  ],

  "values": {
    "outputTimecode": {
      "type": "String",
      "description": "Converted timecode from seconds"
    },
    "outputSeconds": {
      "type": "Float",
      "description": "Converted seconds from timecode"
    }
  },

  "commands": {
    "Set Seconds": {
      "menu": "",
      "callback": "setSeconds",
      "parameters": {
        "seconds": {
          "type": "Float",
          "default": 0.0,
          "description": "Time in seconds to convert to timecode"
        }
      }
    },
    "Set Timecode": {
      "menu": "",
      "callback": "setTimecode",
      "parameters": {
        "timecode": {
          "type": "String",
          "default": "00:00:00:00",
          "description": "Timecode HH:MM:SS:FF to convert to seconds"
        }
      }
    }
  }
}
